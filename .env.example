# =============================================================================
# Capital Academy - Environment Variables
# Copia este archivo a .env.local y completa los valores reales.
# Nunca commits .env.local
# =============================================================================

# -------- App --------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Capital Academy"

# -------- Supabase --------
# Obtener desde https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo backend: clave service_role (NUNCA exponer al cliente)
SUPABASE_SERVICE_ROLE_KEY=

# -------- Resend (email) --------
RESEND_API_KEY=
RESEND_FROM_EMAIL="Capital Academy <no-reply@capitalacademy.cl>"

# -------- Slack --------
# Token de bot user OAuth (xoxb-...)
SLACK_BOT_TOKEN=
# Default channel/workspace settings
SLACK_DEFAULT_WORKSPACE_ID=

# -------- Mux (video pregrabado) --------
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_WEBHOOK_SECRET=

# -------- Google Drive (entregas de tareas) --------
# Service account JSON o OAuth credentials
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# -------- Sentry (opcional, recomendado para producción) --------
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
